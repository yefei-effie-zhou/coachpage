{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ducknotebook",
  "main": "worker.js",
  "compatibility_date": "2026-11-23",
  "workers_dev": true,
  "preview_urls": false,
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dutch-transcript-db",
      "database_id": "c0c42df5-d121-493f-87bd-c9cc3746ab68",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "AUDIO_BUCKET",
      "bucket_name": "notebook-audio"
    }
  ]
}
